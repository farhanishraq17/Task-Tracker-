# Copy this file to `.env` and fill in only the integrations you want.
# Everything here is optional: the app works fully offline without it.
# Never commit `.env` (it is git-ignored).

# ---- Server ----
# PORT=3000
# HOST=127.0.0.1        # use 0.0.0.0 to reach the app from other devices on your Wi-Fi
# DATA_DIR=./data       # where app.db, backups/ and files/ live

# ---- Email reminders (any SMTP account) ----
# Gmail: enable 2-step verification, create an App Password (myaccount.google.com/apppasswords), use it as SMTP_PASS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false      # true only for port 465
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# EMAIL_FROM=you@gmail.com   # defaults to SMTP_USER
# EMAIL_TO=you@gmail.com     # defaults to SMTP_USER

# ---- WhatsApp reminders ----
# Pick ONE provider. Phone numbers in international format, e.g. +8801XXXXXXXXX
# WHATSAPP_TO=+8801XXXXXXXXX

# Option A: Meta WhatsApp Cloud API (developers.facebook.com → My Apps → WhatsApp → API Setup)
# WHATSAPP_PROVIDER=meta
# WHATSAPP_TOKEN=EAAG...            # permanent System User token recommended (test tokens expire in 24h)
# WHATSAPP_PHONE_NUMBER_ID=1234567890
# WHATSAPP_API_VERSION=v21.0

# Option B: Twilio (console.twilio.com → Messaging → Try it out → Send a WhatsApp message)
# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # sandbox number, or your approved sender
